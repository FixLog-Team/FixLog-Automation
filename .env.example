# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.
# 비워 둔 값은 기본값을 쓴다.

# 자동화 대상 주소
FIXLOG_BASE_URL=https://fix-log-front-theta.vercel.app

# 테스트 Google 계정(python -m app.cli auth 때 로그인 칸 자동 입력용). 비우면 브라우저에서 직접 입력한다
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# chromium / firefox / webkit
BROWSER_TYPE=chromium
# true: 화면 없이 실행, false: 브라우저 창 표시
HEADLESS=true

# 로그인 상태 파일(기본 backend/.auth/state.json), 실행 결과 폴더(기본 backend/data)
AUTH_STATE_PATH=
DATA_DIR=

# 대상 문서 제목(비우면 문서 목록 첫 문서). 문서 작성 단계가 있는 실행은 작성한 문서를 쓴다
TEST_DOCUMENT_TITLE=
# 제목 검색어·AI 질문(비우면 대상 문서 제목 앞 10자). 문서 작성 단계가 있는 실행은 작성한 문서 제목을 쓴다
TEST_SEARCH_KEYWORD=
